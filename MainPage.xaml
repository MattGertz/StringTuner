<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StringTuner.MainPage"
             BackgroundColor="#F0F1EB">
    <ScrollView>
        <VerticalStackLayout Padding="22,20,22,28" Spacing="18">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="STRINGTUNER" FontSize="13" FontAttributes="Bold" TextColor="#1B2826" />
                    <Label Text="PRECISION / 01" FontSize="10" CharacterSpacing="1.4" TextColor="#75817B" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                    <Label Text="REFERENCE" FontSize="9" CharacterSpacing="1.2" TextColor="#75817B" HorizontalTextAlignment="End" />
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding ReferencePitchText}" FontSize="12" FontAttributes="Bold" TextColor="#1B2826" VerticalTextAlignment="Center" />
                        <Stepper Minimum="430" Maximum="450" Increment="1" Value="{Binding ReferencePitch}" WidthRequest="92" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="3">
                <Label Text="INSTRUMENT / TUNING" FontSize="10" CharacterSpacing="1.4" TextColor="#75817B" />
                <Picker ItemsSource="{Binding Instruments}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedInstrument}"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#17211F"
                        BackgroundColor="Transparent" />
                <Label Text="{Binding TuningName}" FontSize="12" TextColor="#75817B" />
                  <Label Text="{Binding CatalogError}"
                      IsVisible="{Binding HasCatalogError}"
                      FontSize="12"
                      TextColor="#A3452F"
                      LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding StringOptions}"
                            SelectedItem="{Binding SelectedString, Mode=TwoWay}"
                            SelectionMode="Single"
                            HeightRequest="64"
                            HorizontalScrollBarVisibility="Never"
                            ItemsLayout="HorizontalList"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#D6DBD4" StrokeThickness="1" BackgroundColor="#1B2826" Padding="15,8" Margin="0,0,8,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#47796F" />
                                            <Setter Property="Stroke" Value="#47796F" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Label}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#F2F4EE"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border BackgroundColor="#1B2826" Padding="20,18" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding TargetOctave}" FontSize="10" CharacterSpacing="1.3" TextColor="#A8B3AE" />
                            <Label Text="{Binding TargetNote}" FontSize="46" FontAttributes="Bold" TextColor="#F2F4EE" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="TARGET" FontSize="9" CharacterSpacing="1.2" TextColor="#A8B3AE" HorizontalTextAlignment="End" />
                            <Label Text="{Binding TargetFrequencyText}" FontSize="14" FontAttributes="Bold" TextColor="#F2F4EE" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="End">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="MEASURED" FontSize="9" CharacterSpacing="1.2" TextColor="#A8B3AE" />
                            <HorizontalStackLayout Spacing="5" VerticalOptions="End">
                                <Label Text="{Binding MeasuredFrequencyText}" FontSize="31" FontAttributes="Bold" TextColor="#F2F4EE" />
                                <Label Text="Hz" FontSize="13" TextColor="#A8B3AE" VerticalTextAlignment="End" Padding="0,0,0,5" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="End">
                            <Label Text="{Binding TuningState}" FontSize="11" CharacterSpacing="1.1" FontAttributes="Bold" TextColor="{Binding TuningStateColor}" HorizontalTextAlignment="End" />
                            <Label Text="{Binding CentsDeviationText}" FontSize="27" FontAttributes="Bold" TextColor="{Binding TuningStateColor}" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <GraphicsView x:Name="TuningGauge" HeightRequest="56" />
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <Label Text="-50¢" FontSize="10" TextColor="#A8B3AE" />
                        <Label Grid.Column="1" Text="-25¢" FontSize="10" TextColor="#A8B3AE" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="0¢" FontSize="10" TextColor="#D6E0D8" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="+25¢" FontSize="10" TextColor="#A8B3AE" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="+50¢" FontSize="10" TextColor="#A8B3AE" HorizontalTextAlignment="End" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <BoxView WidthRequest="7" HeightRequest="7" Color="{Binding TuningStateColor}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding SignalState}" FontSize="10" CharacterSpacing="0.6" TextColor="#A8B3AE" VerticalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="{Binding ConfidenceText}" FontSize="10" TextColor="#A8B3AE" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{Binding ListeningButtonText}"
                        Command="{Binding ToggleListeningCommand}"
                        BackgroundColor="#1B2826"
                        TextColor="#F2F4EE"
                        FontAttributes="Bold"
                        CornerRadius="5"
                        HeightRequest="52" />
                <Button Grid.Column="1"
                        Text="{Binding ToneButtonText}"
                        Command="{Binding ToggleToneCommand}"
                        BackgroundColor="#D9E8D8"
                        TextColor="#1B2826"
                        FontAttributes="Bold"
                        CornerRadius="5"
                        HeightRequest="52" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                <Label Text="TONE LEVEL" FontSize="10" CharacterSpacing="1.1" TextColor="#75817B" VerticalTextAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0.05" Maximum="0.8" Value="{Binding ToneVolume}" MinimumTrackColor="#4CAAB2" MaximumTrackColor="#CFD5CE" ThumbColor="#1B2826" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
